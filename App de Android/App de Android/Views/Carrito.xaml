<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_de_Android.Views.Carrito">

    <StackLayout Padding="15,30,15,0" Spacing="20" VerticalOptions="FillAndExpand">
        <!-- Encabezado con botón de regreso -->
        <Frame VerticalOptions="Start" HorizontalOptions="FillAndExpand" Padding="0" BorderColor="Transparent" Background="Transparent">
            <Grid ColumnSpacing="10" Padding="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Frame BorderColor="Transparent" BackgroundColor="Transparent" Grid.Column="0" Padding="0" HasShadow="False">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackButtonClicked" />
                    </Frame.GestureRecognizers>
                    <Image Source="https://cdn.icon-icons.com/icons2/2131/PNG/512/back_arrow_icon_131563.png" 
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HeightRequest="25" 
                           WidthRequest="25" />
                </Frame>

                <Label Text="Carrito" 
                       FontSize="32" 
                       Padding="0,0,30,0" 
                       HeightRequest="60"
                       FontAttributes="Bold" 
                       HorizontalOptions="CenterAndExpand" 
                       VerticalOptions="CenterAndExpand" 
                       TextColor="#ff6d00" 
                       Grid.Column="1"/>
            </Grid>
        </Frame>

        <!-- Lista de productos y botón "Siguiente" -->
        <ScrollView>
            <StackLayout Spacing="15">
                <!-- Lista de productos -->
                <ListView x:Name="CartListView" HasUnevenRows="True" Margin="0" VerticalOptions="FillAndExpand">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Grid Padding="10" ColumnSpacing="10" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>

                                    <StackLayout VerticalOptions="Center" HorizontalOptions="Start" Grid.Column="0" Orientation="Vertical">
                                        <Button Text="▲" Clicked="OnIncreaseClicked" />
                                        <Label Text="{Binding Amount}" VerticalOptions="Center" HorizontalOptions="Center" />
                                        <Button Text="▼" Clicked="OnDecreaseClicked" />
                                    </StackLayout>

                                    <Image Source="{Binding Image}" WidthRequest="80" HeightRequest="80" VerticalOptions="Center" HorizontalOptions="Center" Grid.Column="1" />

                                    <StackLayout VerticalOptions="Center" HorizontalOptions="Start" Grid.Column="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" />
                                        <Label Text="{Binding Price, StringFormat='{0:C}'}" FontSize="16" />
                                    </StackLayout>

                                    <Button Text="X" Clicked="OnRemoveClicked" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="3" Margin="0,0,20,0" />
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Botón al final de los productos -->
                <Frame CornerRadius="25"
                       Padding="0"
                       BackgroundColor="#ff6d00"
                       HorizontalOptions="Center"
                       VerticalOptions="End"
                       HeightRequest="60"
                       WidthRequest="300">
                    <Grid>
                        <Label Text="Siguiente"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="White"
                               FontSize="22"
                               FontAttributes="Bold" />
                    </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNextTapped" />
                    </Frame.GestureRecognizers>
                </Frame>
            </StackLayout>
        </ScrollView>
    </StackLayout>
</ContentPage>
