<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_de_Android.Views.AddressListView">
    <ContentPage.Content>
        <StackLayout Padding="20">
            <Label Text="Your Addresses" FontSize="Large" HorizontalOptions="Center" />
            <ListView x:Name="AddressListViewControl">
                <!-- Changed x:Name to AddressListViewControl -->
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextCell Text="{Binding}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Text="+" Clicked="OnAddAddressClicked" HorizontalOptions="End" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
