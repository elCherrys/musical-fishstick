<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_de_Android.Views.News">
    <AbsoluteLayout>

        <!-- Background content (existing frames) -->
        <StackLayout Spacing="0" Padding="20,0" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0, 0, 1, 1">
            <Label Text="Noticias" FontSize="32" Padding="0,20,0,0" FontAttributes="Bold" VerticalOptions="StartAndExpand" HorizontalOptions="CenterAndExpand" TextColor="#ff6d00"/>

            <!-- Primer Frame -->
            <Frame CornerRadius="20" Padding="0" HasShadow="True" HeightRequest="200" VerticalOptions="StartAndExpand">
                <Grid>
                    <Image x:Name="Frame1Image" Aspect="AspectFill" />
                    <Label x:Name="Frame1Label"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="#FEDBB9"
                       FontSize="25"
                       FontAttributes="Bold"
                       Opacity="0.6"
                       Padding="10" 
                       Margin="0,0,160,0"/>
                </Grid>
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFrameTapped" CommandParameter="1"/>
                </Frame.GestureRecognizers>
            </Frame>

            <!-- Segundo Frame -->
            <Frame CornerRadius="20" Padding="0" HasShadow="True" HeightRequest="200" VerticalOptions="StartAndExpand">
                <Grid>
                    <Image x:Name="Frame2Image" Aspect="AspectFill" />
                    <Label x:Name="Frame2Label"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="#1E1E1E"
                       FontSize="30"
                       FontAttributes="Bold"
                       Opacity="0.6"
                       Padding="10" 
                       Margin="20,0,120,70"/>
                </Grid>
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFrameTapped" CommandParameter="2"/>
                </Frame.GestureRecognizers>
            </Frame>

            <!-- Tercer Frame -->
            <Frame CornerRadius="20" Padding="0" HasShadow="True" HeightRequest="200" VerticalOptions="StartAndExpand">
                <Grid>
                    <Image x:Name="Frame3Image" Aspect="AspectFill" />
                    <Label x:Name="Frame3Label"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="#104A1D"
                       FontSize="25"
                       FontAttributes="Bold"
                       Opacity="0.6"
                       Padding="10" 
                       Margin="70,0,70,0"/>
                </Grid>
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFrameTapped" CommandParameter="3"/>
                </Frame.GestureRecognizers>
            </Frame>
        </StackLayout>


        <!-- Modal layer (ensure it's hidden by default) -->
        <AbsoluteLayout x:Name="ModalContainer"
                    AbsoluteLayout.LayoutFlags="All"
                    AbsoluteLayout.LayoutBounds="0,0,1,1"
                    IsVisible="False">

            <!-- Semi-transparent background -->
            <BoxView Color="Black"
                 Opacity="0.5"
                 AbsoluteLayout.LayoutFlags="All"
                 AbsoluteLayout.LayoutBounds="0,0,1,1" >
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackgroundTapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Modal content -->
            <Frame CornerRadius="20"
               BackgroundColor="White"
               Padding="20"
               Margin="0,1000,0,0"
               HeightRequest="600"
               VerticalOptions="EndAndExpand"
               AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional"
               AbsoluteLayout.LayoutBounds="0.5, 0.9, 0.9, AutoSize">
                <StackLayout>
                    <!-- Title -->
                    <Label x:Name="ModalTitle" FontSize="24" FontFamily="Noto Sans" HorizontalOptions="Center" TextColor="Black"/>

                    <!-- Circular Image inside a Frame -->
                    <Frame CornerRadius="20" Margin="0,10,0,0" Padding="0" HeightRequest="210" WidthRequest="1000" HorizontalOptions="Center">
                        <Image x:Name="ModalImage" Aspect="AspectFill" HeightRequest="220" WidthRequest="220"/>
                    </Frame>

                    <!-- Subtitle -->
                    <Label x:Name="ModalSubtitle" FontSize="22" HorizontalOptions="Center" TextColor="Black" Padding="16,10,0,0" FontAttributes="Bold"/>

                    <!-- Description -->
                    <Label x:Name="ModalDescription" HorizontalOptions="Center" FontSize="16" TextColor="Black" Padding="5,10,0,0"/>

                    <!-- Close Button -->
                    <Button Text="Cerrar" 
                        HorizontalOptions="End" VerticalOptions="Start" 
                        Clicked="CloseModal" IsVisible="False"/>
                </StackLayout>
            </Frame>
        </AbsoluteLayout>
    </AbsoluteLayout>
</ContentPage>
