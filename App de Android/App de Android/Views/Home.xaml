<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_de_Android.Views.Home">

    <ContentPage.Content>
        <StackLayout BackgroundColor="#FFF3E0">
            <Frame HeightRequest="150" HasShadow="False" BackgroundColor="#FFF3E0">
                <Label Text="Address" TextColor="Black" HorizontalOptions="Center" FontSize="30" VerticalOptions="Center"/>
            </Frame>

            <StackLayout Orientation="Horizontal" Padding="10,0,0,15">
                <Label Text="Categories" TextColor="Black" FontSize="25"/>
                <Label Text="View All" TextColor="Black" FontSize="20" Padding="225,5,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToCategoriesCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </StackLayout>

            <Frame BackgroundColor="#FFF3E0" HeightRequest="140" HasShadow="False" Padding="0,0,0,30">
                <CollectionView ItemsSource="{Binding Categories}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout>
                                <Frame CornerRadius="100" WidthRequest="80" HeightRequest="80" HasShadow="False">
                                    <Image Source="{Binding IconUrl}"/>
                                </Frame>
                                <Label Text="{Binding Name}" HorizontalOptions="Center" TextColor="Black"/>
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>
           
            <StackLayout Orientation="Horizontal" Padding="10,0,0,15">
                <Label Text="Products" TextColor="Black" FontSize="25"/>

                <Label Text="View All" TextColor="Black" FontSize="20" Padding="240,5,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToProductsCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </StackLayout>
            
            <Frame Margin="0" Padding="10" HasShadow="False" CornerRadius="10" BackgroundColor="#FFF3E0" HeightRequest="250">
                <!-- CollectionView to display the product collection in a grid layout -->
                <CollectionView ItemsSource="{Binding Products}">
                    <CollectionView.ItemsLayout>
                        <!-- Define a grid layout with two columns -->
                        <GridItemsLayout Orientation="Horizontal" Span="1" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <!-- Define the layout for each product item -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="5" Padding="10" HasShadow="False" CornerRadius="10" WidthRequest="150">
                                <StackLayout Orientation="Vertical" Padding="10">
                                    <Image Source="{Binding image}" WidthRequest="100" HeightRequest="100" />
                                    <Label Text="{Binding name}" FontSize="16" FontAttributes="Bold" TextColor="Black"/>
                                    <Label Text="{Binding description}" FontSize="12" TextColor="Gray"/>
                                    <Label Text="{Binding price, StringFormat='{0:C}'}" FontSize="14" TextColor="Green"/>
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
