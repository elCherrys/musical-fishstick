<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_de_Android.Views.AddAddressView"
             Title="Add Address">
    <ContentPage.Content>
        <StackLayout Padding="20">
            <Entry x:Name="StreetEntry" Placeholder="Calle" />
            <Entry x:Name="NumberEntry" Placeholder="Número" />
            <Entry x:Name="NeighborhoodEntry" Placeholder="Colonia" />
            <Entry x:Name="CityEntry" Placeholder="Ciudad" />
            <Entry x:Name="StateEntry" Placeholder="Estado" />
            <Button Text="Agregar Direccion" Clicked="OnAddAddressButtonClicked" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
