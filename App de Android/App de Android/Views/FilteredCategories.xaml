<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:App_de_Android.Converters"
             x:Class="App_de_Android.Views.FilteredCategories"
             x:Name="FilteredCategoriesPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:BooleanToColorConverter x:Key="BooleanToColorConverter" TrueColor="#FF5E00" FalseColor="Transparent"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowSpacing="10" BackgroundColor="White">
            <Grid.RowDefinitions>
                <!-- Fila para el encabezado -->
                <RowDefinition Height="Auto" />
                <!-- Fila para el contenido -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackLayout Grid.Row="0" Orientation="Horizontal" Padding="20" Spacing="10" BackgroundColor="White" VerticalOptions="Center">
                <!-- Botón de regreso -->
                <Frame BorderColor="Transparent" BackgroundColor="Transparent" Padding="0" HasShadow="False">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackButtonClicked" />
                    </Frame.GestureRecognizers>
                    <Image Source="https://cdn.icon-icons.com/icons2/2131/PNG/512/back_arrow_icon_131563.png" 
                           HeightRequest="25" 
                           WidthRequest="25" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
                </Frame>

                <!-- Título -->
                <Label Text="Productos" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       HorizontalOptions="CenterAndExpand" 
                       VerticalOptions="Center" 
                       TextColor="#ff6d00" />
            </StackLayout>

            <!-- Contenido -->
            <StackLayout Grid.Row="1" Padding="15,0,15,0">
                <!-- ScrollView para las categorías -->
                <ScrollView Orientation="Horizontal" BackgroundColor="White" Padding="0" IsClippedToBounds="True">
                    <StackLayout Orientation="Horizontal" BindableLayout.ItemsSource="{Binding Categories}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <StackLayout>
                                    <!-- Categorías -->
                                    <Label Text="{Binding Name}" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" 
                                           Padding="10" 
                                           TextColor="#6D3805"
                                           FontAttributes="Bold">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.SelectCategoryCommand, Source={x:Reference FilteredCategoriesPage}}" CommandParameter="{Binding .}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <!-- Indicador de categoría seleccionada -->
                                    <BoxView HeightRequest="2" 
                                             BackgroundColor="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}}" 
                                             HorizontalOptions="FillAndExpand" />
                                </StackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </ScrollView>

                <!-- CollectionView para los productos -->
                <CollectionView ItemsSource="{Binding SelectedCategoryProducts}"
                                SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- Plantilla del producto -->
                            <Frame CornerRadius="10" Margin="5" Padding="10" HasShadow="True" BackgroundColor="White" BorderColor="Gray">
                                <StackLayout Orientation="Vertical">
                                    <!-- Imagen del producto -->
                                    <Image Source="{Binding image}" WidthRequest="100" HeightRequest="100" VerticalOptions="Center" HorizontalOptions="Center"/>

                                    <!-- Nombre del producto -->
                                    <Label Text="{Binding name}" FontSize="20" FontAttributes="Bold" TextColor="#6D3805" HorizontalOptions="StartAndExpand"/>

                                    <!-- Precio y botón en la misma línea -->
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Precio -->
                                        <Label Text="{Binding price, StringFormat='$ {0:F2}'}" 
                                               FontSize="22" 
                                               TextColor="#FF5E00" 
                                               FontAttributes="Bold" 
                                               Grid.Column="0" 
                                               VerticalOptions="Center" />

                                        <!-- Botón -->
                                        <Button Text="+" 
                                                Command="{Binding BindingContext.AddToCartCommand, Source={x:Reference FilteredCategoriesPage}}" 
                                                CommandParameter="{Binding Id}" 
                                                BackgroundColor="Green" 
                                                TextColor="White" 
                                                CornerRadius="20" 
                                                WidthRequest="40" 
                                                HeightRequest="40" 
                                                FontAttributes="Bold" 
                                                Grid.Column="1" 
                                                VerticalOptions="Center" 
                                                HorizontalOptions="End" />
                                    </Grid>
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>
